<?xml version="1.0"?>
<!-- Differential-drive robot with LIDAR, IMU, casters and camera for Gazebo simulation -->
<robot name="my_robot">

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.30" length="0.10" />
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.30" length="0.10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="4.0" />
      <inertia
        ixx="0.0933333333" ixy="0.0" ixz="0.0"
        iyy="0.0933333333" iyz="0.0"
        izz="0.18" />
    </inertial>
  </link>

  <!-- LIDAR -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.10" length="0.10" />
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.4 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.10" length="0.10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3" />
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.0015" />
    </inertial>
  </link>

  <!-- LIDAR mount -->
  <joint name="lidar_mount" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0 0 0.15" rpy="0 0 0" />
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.03 0.015" />
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 1.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.03 0.03 0.015" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.03" />
      <inertia
        ixx="2.8125e-06" ixy="0.0" ixz="0.0"
        iyy="2.8125e-06" iyz="0.0"
        izz="4.5e-06" />
    </inertial>
  </link>

  <!-- IMU mount -->
  <joint name="imu_mount" type="fixed">
    <parent link="base_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0.21" rpy="0 0 0" />
  </joint>

  <!-- Drive wheels -->
  <!-- Left wheel -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.10" length="0.10" />
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.10" length="0.10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia
        ixx="0.0016666667" ixy="0.0" ixz="0.0"
        iyy="0.0025"      iyz="0.0"
        izz="0.0016666667" />
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="0.0 0.23 0.05" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Right wheel -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.10" length="0.10" />
      </geometry>
      <material name="black">
        <color rgba="0.05 0.05 0.05 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.10" length="0.10" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia
        ixx="0.0016666667" ixy="0.0" ixz="0.0"
        iyy="0.0025"      iyz="0.0"
        izz="0.0016666667" />
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="0.0 -0.23 0.05" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <!-- Casters -->

  <!-- Front caster
  <link name="caster_front_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004" />
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <sphere radius="0.06" />
      </geometry>
      <material name="caster_wheel_f">
        <color rgba="1.0 1.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <sphere radius="0.06" />
      </geometry>
    </collision>
  </link>

  <joint name="caster_front_joint" type="continuous">
    <parent link="base_link" />
    <child link="caster_front_link" />
    <origin xyz="0.22 0 0.0105" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <link name="caster_back_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004" />
    </inertial>
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <sphere radius="0.06" />
      </geometry>
      <material name="caster_wheel_b">
        <color rgba="1.0 1.0 0.0 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
      <geometry>
        <sphere radius="0.06" />
      </geometry>
    </collision>
  </link>

  <joint name="caster_back_joint" type="continuous">
    <parent link="base_link" />
    <child link="caster_back_link" />
    <origin xyz="-0.22 0 0.0105" rpy="0 0 0" />
    <axis xyz="0 0 1" />
  </joint> -->

  <!-- Camera mount -->
  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.15" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.02" length="0.15" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.1" />
      <inertia
        ixx="1e-4" ixy="0" ixz="0"
        iyy="1e-4" iyz="0"
        izz="1e-4" />
    </inertial>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_mount_link" />
    <origin xyz="0.25 0 0.16" rpy="0 0 0" />
  </joint>

  <!-- camera body -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.03 0.04" />
      </geometry>
      <material name="camera_gray">
        <color rgba="0.4 0.4 0.4 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.03 0.04" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia
        ixx="2e-4" ixy="0" ixz="0"
        iyy="2e-4" iyz="0"
        izz="2e-4" />
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount_link" />
    <child link="camera_link" />
    <origin xyz="0.05 0 0" rpy="0 0 0" />
  </joint>

  <!-- ====================== Gazebo ====================== -->

  <!-- IMU plugin -->
  <gazebo>
    <plugin
      filename="libignition-gazebo-imu-system"
      name="ignition::gazebo::systems::Imu">
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <topic>/sensors/imu/data_raw</topic>
    </sensor>
  </gazebo>

  <!-- Differential drive plugin and joint state publisher -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <topic>/cmd_vel</topic>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>0.1</wheel_radius>

      <max_velocity>3.0</max_velocity>
      <max_linear_acceleration>1</max_linear_acceleration>
      <min_linear_acceleration>-1</min_linear_acceleration>
      <max_angular_acceleration>2</max_angular_acceleration>
      <min_angular_acceleration>-2</min_angular_acceleration>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1</max_angular_velocity>
      <min_angular_velocity>-1</min_angular_velocity>

      <odom_topic>/wheel_encoder/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>60</odom_publish_frequency>
    </plugin>

    <!-- Joint state publisher plugin -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <!-- <joint_name>caster_front_joint</joint_name>
      <joint_name>caster_back_joint</joint_name> -->
    </plugin>
  </gazebo>

  <!-- RGB camera sensor -->
  <gazebo reference="camera_link">
    <sensor name="cam_rgb" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>60</update_rate>

      <camera name="cam_rgb">
        <horizontal_fov>1.02974</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>

        <camera_info>
          <width>320</width>
          <height>240</height>
          <K>700 0 960 0 700 540 0 0 1</K>
          <D>0 0 0 0 0</D>
          <distortion_model>plumb_bob</distortion_model>
        </camera_info>
        <camera_info_topic>sensors/camera_info</camera_info_topic>
        <optical_frame_id>camera_link</optical_frame_id>
      </camera>

      <topic>sensors/image_rect_color</topic>
    </sensor>
  </gazebo>

  <!-- 2D lidar sensor -->
  <gazebo reference="lidar_link">
    <sensor type="gpu_lidar" name="lidar_link_sensor">
      <always_on>1</always_on>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <topic>/sensors/points</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.8</min>
          <max>60.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

</robot>